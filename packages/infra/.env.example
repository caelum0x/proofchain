# @proofchain/infra — environment variables
# All are OPTIONAL: the package degrades gracefully when they are unset, but any
# value that IS provided must be well-formed (validated at load, fails fast).

# --- Supabase (persistence) --------------------------------------------------
# Both are required together to enable the store; otherwise it no-ops.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- IPFS / Pinata -----------------------------------------------------------
# Set PINATA_JWT to pin to real IPFS; unset → local ipfs://mock/<sha256> fallback.
PINATA_JWT=
# Optional overrides (sensible defaults applied if unset):
PINATA_API_URL=https://api.pinata.cloud
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
