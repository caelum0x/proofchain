# =============================================================================
# ProofChain — aggregated environment variables (ALL packages)
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env` (only this template is tracked).
# Each variable is documented with which package consumes it. Secrets (private
# keys, service-role key, API keys) are SERVER-SIDE ONLY and must never be
# exposed to the browser — only NEXT_PUBLIC_* vars reach the web bundle.
# =============================================================================

# --- Chain -------------------------------------------------------------------
# ProofChain runs LIVE on Ethereum Sepolia (chainId 11155111).
# JSON-RPC endpoint for the target chain. Used by: contracts (deploy),
# agent + api (chain reads/writes). Default public endpoint:
# https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional dedicated Ethereum Sepolia RPC override (falls back to the value
# above / a public endpoint when unset). Used by: shared/agent/api.
ETHEREUM_SEPOLIA_RPC_URL=
# Server-side chain id override (agent, api). Default: 11155111 (Ethereum Sepolia).
CHAIN_ID=11155111
# Target chain id for the web dApp. Default: 11155111 (Ethereum Sepolia).
NEXT_PUBLIC_CHAIN_ID=11155111
# Optional: web read RPC override (public — no secrets). Default: public Sepolia RPC.
NEXT_PUBLIC_RPC_URL=

# --- Contracts / deploy ------------------------------------------------------
# Deployer account private key (pays gas, becomes DEFAULT_ADMIN). Used by: contracts.
# SECRET — server-side only.
DEPLOYER_PRIVATE_KEY=
# Address granted AGENT_ROLE on AttestationRegistry. MUST equal AGENT_PRIVATE_KEY's
# address. Used by: contracts (deploy).
AGENT_ADDRESS=

# --- Agent service -----------------------------------------------------------
# Anthropic API key for the Claude verification agent. Fail-fast if missing.
# Used by: agent. SECRET — server-side only.
ANTHROPIC_API_KEY=
# Private key of the agent signer that holds AGENT_ROLE and submits attest(...).
# Used by: agent. SECRET — server-side only.
AGENT_PRIVATE_KEY=
# When "true", the agent auto-calls settle(batchId) after a passing attestation.
# Used by: agent.
SETTLE_ON_ATTEST=false
# HTTP port the agent listens on (optional; default 8080). Used by: agent.
PORT=8080

# --- Storage: IPFS (Pinata) --------------------------------------------------
# Pinata JWT for pinning verdicts. Unset → local ipfs://mock/<sha256> fallback.
# Used by: infra, agent. SECRET — server-side only.
PINATA_JWT=
# Optional Pinata API base override (default https://api.pinata.cloud). Used by: infra.
PINATA_API_URL=https://api.pinata.cloud
# Optional IPFS gateway for building HTTPS content links
# (default https://gateway.pinata.cloud/ipfs). Used by: infra.
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# --- Storage: Supabase -------------------------------------------------------
# Supabase project URL. Unset → infra store no-ops (agent uses in-memory fallback).
# Used by: infra, agent.
SUPABASE_URL=
# Supabase service-role key. Used by: infra, agent. SECRET — server-side only;
# bypasses RLS, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web (Next.js dApp) ------------------------------------------------------
# WalletConnect Cloud project id. Used by: web (public).
NEXT_PUBLIC_WALLETCONNECT_ID=
# Public URL of the deployed agent service. Used by: web (public).
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8080
# Public URL of the @proofchain/api platform backend. Used by: web (public).
NEXT_PUBLIC_API_URL=http://localhost:8081
