# @proofchain/contracts — environment variables
# Copy to .env and fill in. NEVER commit real secrets.

# RPC endpoint for Base Sepolia (chainId 84532)
BASE_SEPOLIA_RPC_URL=

# Private key of the deploying account (0x-prefixed, 64 hex chars).
# Used by `pnpm deploy:base-sepolia`. Keep this out of version control.
DEPLOYER_PRIVATE_KEY=

# Address granted AGENT_ROLE on AttestationRegistry (the verification agent signer).
AGENT_ADDRESS=

# Optional: block explorer API key for --verify during deploy.
ETHERSCAN_API_KEY=
