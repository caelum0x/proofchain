# @proofchain/shared environment variables
#
# This package holds NO secrets. Every variable below is optional and only
# influences which chain endpoint / contract addresses are resolved at runtime.
# Consumers (agent, web) provide these; the package degrades gracefully when
# they are absent.

# --- Chain ---------------------------------------------------------------
# RPC endpoint used by the exported `baseSepolia` viem chain. Falls back to the
# public https://sepolia.base.org endpoint when unset.
BASE_SEPOLIA_RPC_URL=

# --- Contract address overrides -----------------------------------------
# Take precedence over the on-disk deployment manifest
# (packages/contracts/deployments/base-sepolia.json). The NEXT_PUBLIC_* forms
# are read in browser bundles where the manifest file cannot be read.
PROVENANCE_REGISTRY_ADDRESS=
ATTESTATION_REGISTRY_ADDRESS=
SETTLEMENT_ESCROW_ADDRESS=
MOCK_USDC_ADDRESS=

NEXT_PUBLIC_PROVENANCE_REGISTRY_ADDRESS=
NEXT_PUBLIC_ATTESTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_ESCROW_ADDRESS=
NEXT_PUBLIC_MOCK_USDC_ADDRESS=

# --- Deployment manifest path override -----------------------------------
# Absolute or relative path to the deployment JSON. Defaults to
# packages/contracts/deployments/base-sepolia.json.
PROOFCHAIN_DEPLOYMENTS_FILE=
