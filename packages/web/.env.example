# ─────────────────────────────────────────────────────────────
# @proofchain/web — environment variables
# Copy to `.env.local` and fill in. All are exposed to the browser
# (NEXT_PUBLIC_ prefix) — NEVER put private keys or secrets here.
# ─────────────────────────────────────────────────────────────

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Required for RainbowKit / WalletConnect wallets.
NEXT_PUBLIC_WALLETCONNECT_ID=

# Base URL of the @proofchain/agent verification API.
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8080

# Target chain id. ProofChain runs on Base Sepolia (84532).
NEXT_PUBLIC_CHAIN_ID=84532

# Optional: block number the contracts were deployed at. Used as the
# `fromBlock` when back-filling historical events for the verifier
# dashboard. Leave empty to scan from genesis (slower on public RPC).
NEXT_PUBLIC_DEPLOY_BLOCK=

# Optional: override the JSON-RPC endpoint used for reads. When empty the
# app uses the public Base Sepolia RPC bundled with viem.
NEXT_PUBLIC_RPC_URL=
