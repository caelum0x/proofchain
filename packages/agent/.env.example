# =============================================================================
# @proofchain/agent — environment
# Copy to `.env` and fill in. NEVER commit a real `.env`. No secret is hardcoded
# in source; all are read + validated at startup (the service fails fast if a
# required value is missing or malformed).
# =============================================================================

# --- Required secrets / connectivity ----------------------------------------
# Anthropic API key for the Claude verification model.
ANTHROPIC_API_KEY=

# Agent signer private key (0x + 64 hex chars). Must hold AGENT_ROLE on the
# AttestationRegistry. Fund it with Ethereum Sepolia ETH for gas.
AGENT_PRIVATE_KEY=

# JSON-RPC endpoint for the target chain (must be a valid URL).
# ProofChain runs LIVE on Ethereum Sepolia; default public endpoint:
# https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- Behavior (optional) -----------------------------------------------------
# When true, call settle(batchId) on the SettlementEscrow after a successful
# attestation. Default: false.
SETTLE_ON_ATTEST=false

# Target chain id. Default: 11155111 (Ethereum Sepolia).
CHAIN_ID=11155111

# Pass threshold in basis points (0..10000). Default: 7000 (mirrors escrow).
PASS_THRESHOLD_BPS=7000

# --- Storage (optional) ------------------------------------------------------
# Pinata JWT for pinning verdict JSON to IPFS. If unset, a deterministic local
# fallback URI (ipfs://mock/<sha256>) is used so the service runs offline.
PINATA_JWT=

# --- Model configuration -----------------------------------------------------
# Reasoning model for the verification loop. Default: claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8
# Cheaper model for document field extraction. Default: claude-haiku-4-5.
ANTHROPIC_PARSE_MODEL=claude-haiku-4-5
# Max output tokens per model call. Default: 4096.
ANTHROPIC_MAX_TOKENS=4096

# --- Orchestrator safety rails ----------------------------------------------
# Max Claude tool-calling iterations before failing closed. Default: 12.
MAX_TOOL_ITERATIONS=12
# Wall-clock timeout (ms) for one verification. Default: 120000.
VERIFY_TIMEOUT_MS=120000
# Max documents accepted per request. Default: 16.
MAX_DOCUMENTS=16

# --- HTTP --------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
# Rate limiting: max requests per window per IP.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
